# Copie este archivo como .env y complete los valores.
# .env NUNCA se sube a git (está en .gitignore). En el hosting (Render), estos mismos
# nombres se configuran como variables de entorno.

# --- Obligatorias ---------------------------------------------------------------
# Usuario de Silogtran que usará la API (recomendado: uno dedicado, solo con acceso a este informe)
SILOGTRAN_USUARIO=
SILOGTRAN_CLAVE=
# Token fijo que deben enviar los clientes:  Authorization: Bearer <API_KEY>  (mínimo 24 caracteres)
# Generar uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Solo necesario para el modo API (api_liquidacion.py). Para el modo sync (sync.py) no se usa.
API_KEY=

# --- Modo SYNC a base de datos (sync.py → Supabase, recomendado) ------------------
# Vuelca el informe a Supabase para que QlikSense lea la tabla (sin API prendida 24/7).
# Cadena del POOLER EN MODO SESIÓN de Supabase (Project Settings → Database → Connection string →
# "Session pooler"), con la contraseña y ?sslmode=require al final. Ej:
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-xx.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=
# reciente (por defecto): mes anterior + mes en curso. rango: usa las fechas de abajo (backfill).
MODE=reciente
SYNC_FECHA_INICIAL=
SYNC_FECHA_FINAL=
# Pausa base tras un login fallido del sync (x4: 30 min, 2 h, 8 h, 24 h)
LOGIN_BACKOFF_MIN=30

# --- Cortes de liquidación (MODE=corte; en GitHub van como Variables de Actions) ---
# Número del primer corte; luego +1 por cada corte con liquidaciones nuevas
CORTE_INICIAL=1
# yyyy-MM-dd: solo entran a un corte las liquidaciones creadas desde esta fecha
CORTES_DESDE=

# --- Opcionales (valor por defecto) -----------------------------------------------
# Centro de costo con el que entra (paso 2 del login). Vacío = el único disponible. Ej: 1-1
SILOGTRAN_CENTROCOSTO=
SILOGTRAN_URL=https://construproyec.colombiasoftware.net
HOST=0.0.0.0
PORT=8000

# --- AWS WAF (firewall de Silogtran) ----------------------------------------------
# Silogtran está detrás de AWS WAF, que exige un "challenge" en JavaScript. La API lo resuelve
# con un Chromium headless (Playwright) y reutiliza el token. Es una solución temporal: lo ideal
# es que Colombia Software autorice la IP del servidor en su WAF.
# WAF_NAVEGADOR=0 desactiva el navegador (la API responderá con un error claro si hay bloqueo).
WAF_NAVEGADOR=1
# Segundos de espera para que el navegador obtenga el token (súbalo si la red es lenta)
WAF_ESPERA_SEG=30
# User-Agent usado por el navegador y por la sesión (deben coincidir para el WAF). Vacío = Chrome por defecto.
NAVEGADOR_UA=

# Rango máximo de días por consulta
MAX_DIAS_RANGO=366
# El rango se consulta a Silogtran por mes calendario y cada mes se guarda en caché.
# Bloques que terminan en los últimos DIAS_RECIENTES días usan la caché corta (los datos aún cambian)
DIAS_RECIENTES=7
CACHE_MINUTOS_RECIENTE=15
CACHE_MINUTOS_HISTORICO=15
# Máximo de bloques guardados en memoria
CACHE_MAX_BLOQUES=100

# Paginación: filas por página si no se envía limit, y máximo permitido
LIMITE_DEFECTO=1000
LIMITE_MAXIMO=10000

# Reintentos ante fallas de Silogtran (espera 2, 4, 8... segundos) y timeout por petición
REINTENTOS=3
TIMEOUT_SILOGTRAN_SEG=300

# Cada cuántos minutos se "toca" Silogtran para que la sesión no venza (0 = desactivado)
KEEPALIVE_MINUTOS=10
# Autoping: la API se llama a sí misma (/health) para que Render gratuito no la duerma.
# En Render no hay que configurar nada (usa RENDER_EXTERNAL_URL automáticamente).
# AUTOPING_URL solo si se despliega en otro hosting. AUTOPING_MINUTOS=0 lo desactiva.
AUTOPING_URL=
AUTOPING_MINUTOS=10
# Cada cuántos minutos se refresca en segundo plano el mes en curso (0 = desactivado)
PRECARGA_MINUTOS=10
# Consultas permitidas por minuto por IP
MAX_PETICIONES_MINUTO=20
# Límite total (todos los clientes) y de intentos con token inválido por IP, por minuto
MAX_PETICIONES_MINUTO_TOTAL=40
MAX_TOKEN_INVALIDO_MINUTO=10
# Protección del usuario de Silogtran: pausa tras un login fallido (x4 por fallo: 30 min, 2 h, 8 h, 24 h)
# y topes de logins por hora y por día
LOGIN_ESPERA_MINUTOS=30
LOGIN_MAX_POR_HORA=2
LOGIN_MAX_POR_DIA=3
